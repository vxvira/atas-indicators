<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <AtasDir Condition="'$(AtasDir)'==''">C:\Program Files\ATAS X</AtasDir>
    <NoWarn>CS8618;CS8625;NU1701;NU1603;xUnit1013</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="*" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\StyledCandlesX\StyledCandlesX.csproj" />
    <Reference Include="ATAS.Indicators"><HintPath>$(AtasDir)\ATAS.Indicators.dll</HintPath></Reference>
    <Reference Include="ATAS.Types"><HintPath>$(AtasDir)\ATAS.Types.dll</HintPath></Reference>
    <Reference Include="OFT.Rendering"><HintPath>$(AtasDir)\OFT.Rendering.dll</HintPath></Reference>
    <Reference Include="OFT.Core"><HintPath>$(AtasDir)\OFT.Core.dll</HintPath></Reference>
    <Reference Include="Utils.Common"><HintPath>$(AtasDir)\Utils.Common.dll</HintPath></Reference>
    <Reference Include="OFT.Attributes"><HintPath>$(AtasDir)\OFT.Attributes.dll</HintPath></Reference>
    <Reference Include="System.Drawing.Common"><HintPath>$(AtasDir)\System.Drawing.Common.dll</HintPath></Reference>
    <Reference Include="SkiaSharp"><HintPath>$(AtasDir)\SkiaSharp.dll</HintPath></Reference>
    <None Include="$(AtasDir)\libSkiaSharp.dll" Link="libSkiaSharp.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
